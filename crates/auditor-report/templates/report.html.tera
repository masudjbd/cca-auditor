<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CCAudit Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; margin: 40px; line-height: 1.6; color: #333; }
        h1 { color: #2c3e50; border-bottom: 2px solid #3498db; padding-bottom: 10px; }
        h2 { color: #34495e; margin-top: 30px; }
        table { width: 100%; border-collapse: collapse; margin: 20px 0; }
        th, td { border: 1px solid #bdc3c7; padding: 12px; text-align: left; }
        th { background: #ecf0f1; font-weight: bold; }
        tr:nth-child(even) { background: #f9f9f9; }
        .stat { display: inline-block; margin-right: 30px; }
        .stat-label { font-size: 0.9em; color: #7f8c8d; }
        .stat-value { font-size: 1.5em; font-weight: bold; color: #2c3e50; }
        .high { color: #e74c3c; font-weight: bold; }
        .medium { color: #f39c12; font-weight: bold; }
        .low { color: #27ae60; font-weight: bold; }
    </style>
</head>
<body>
    <h1>CCAudit Report</h1>
    <p>Generated: <strong>{{ generated_at }}</strong></p>

    <h2>Summary</h2>
    <div class="stat">
        <div class="stat-label">Total Sessions</div>
        <div class="stat-value">{{ session_count }}</div>
    </div>
    <div class="stat">
        <div class="stat-label">Total Events</div>
        <div class="stat-value">{{ event_count }}</div>
    </div>
    <div class="stat">
        <div class="stat-label">Duration</div>
        <div class="stat-value">{{ duration_hours }}h {{ duration_mins }}m</div>
    </div>

    <h2>Sessions</h2>
    <table>
        <thead>
            <tr>
                <th>Tool</th>
                <th>PID</th>
                <th>Started</th>
                <th>Ended</th>
                <th>Confidence</th>
            </tr>
        </thead>
        <tbody>
            {% for session in sessions %}
            <tr>
                <td>{{ session.tool_id }}</td>
                <td>{{ session.pid }}</td>
                <td>{{ session.started_at }}</td>
                <td>{{ session.ended_at | default(value="Active") }}</td>
                <td>{{ session.confidence }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <h2>Events</h2>
    <table>
        <thead>
            <tr>
                <th>Time</th>
                <th>Tool</th>
                <th>Type</th>
                <th>Details</th>
                <th>Confidence</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
            <tr>
                <td>{{ event.timestamp }}</td>
                <td>{{ event.tool_id }}</td>
                <td>{{ event.kind }}</td>
                <td>{{ event.details }}</td>
                <td>{{ event.confidence }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>

    <footer style="margin-top: 50px; padding-top: 20px; border-top: 1px solid #ecf0f1; color: #7f8c8d; font-size: 0.9em;">
        <p>CCAudit — Audit trail for AI coding tools. <a href="https://github.com/masudjbd/cca-auditor">View on GitHub</a></p>
    </footer>
</body>
</html>
